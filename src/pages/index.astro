---
// TRANG CHỦ — nội dung: src/content/trang/trang-chu.json (+ Khối dùng chung, Nhãn hàng, Tin tức)
import Base from '../layouts/Base.astro';
import Anh from '../components/Anh.astro';
import BanLe from '../components/BanLe.astro';
import DaiSoLieu from '../components/DaiSoLieu.astro';
import ChungNhan from '../components/ChungNhan.astro';
import DauMoc from '../components/DauMoc.astro';
import DongHanh from '../components/DongHanh.astro';
import tc from '../content/trang/trang-chu.json';
import { khoiChung, layNhanHang, layTinTrangChu, duongDanTin } from '../lib/noi-dung';
import { tieuDe, dong, chuTron, ngayThang } from '../lib/chu';
import { bieuTuong } from '../lib/bieu-tuong';

const nhan = await layNhanHang();
const tin = await layTinTrangChu(3);
const tenMuc = { 'tin-doanh-nghiep': 'Tin doanh nghiệp', 'tin-thi-truong': 'Tin thị trường' } as Record<string, string>;
const { dau_trang: h, vi_sao, he_sinh_thai: hst, quy_trinh: qt, tap_the: tt, sinh_ke: sk, nguyen_lieu: nl,
        dau_moc: dm, nguoi_dung_dau: ng, ban_tin: bt, nha_phan_phoi: npp } = tc;
---
<Base tieuDe={tc.seo_tieu_de} moTa={tc.seo_mo_ta} anhChiaSe={h.anh} coHero>
  <section class="hero">
    <div class="hero__img"><Anh src={h.anh} alt="Nhà máy Komlife tại Yên Mỹ, Hưng Yên nhìn từ trên cao" sizes="100vw" loading="eager" fetchpriority="high" /></div>
    <div class="hero__veil"></div>
    {h.ghi_chu_tren_anh && <div class="hero__note" set:html={dong(h.ghi_chu_tren_anh)} />}
    <div class="wrap hero__in">
      <div class="hero__txt stack g20">
        <div class="hv"><div class="eb">{h.nhan}</div></div>
        <h1 class="hv" set:html={tieuDe(h.tieu_de)} />
        <p class="hero__sub hv" set:html={dong(h.mo_ta)} />
        <div class="btnrow hv">
          <a class="btn btn--light tu" href="/nhan-hang">{h.nut_1}</a>
          <a class="btn btn--outline-light tu" href="/ve-komlife">{h.nut_2}</a>
        </div>
        <div class="scrollcue hv"><i>↓</i> Cuộn để khám phá</div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div class="stack g16">
        <div class="eb">{vi_sao.nhan}</div>
        <h2 set:html={tieuDe(vi_sao.tieu_de)} />
      </div>
      <div class="stack g20">
        <p class="lead" set:html={dong(vi_sao.doan_1)} />
        {vi_sao.cam_ket && <p class="lead muted"><strong style="color:var(--ink)">Cam kết chất lượng:</strong> <Fragment set:html={dong(vi_sao.cam_ket)} /></p>}
        <a class="btn btn--ghost" href="/ve-komlife" style="align-self:flex-start">{vi_sao.nut}</a>
      </div>
    </div>
  </section>

  <section class="pp pp-eco">
    <div class="pp-eco__l">
      <div class="pp-eb">{hst.nhan}</div>
      <h2 class="pp-h" set:html={tieuDe(hst.tieu_de, 'i')} />
      <p class="pp-body" set:html={dong(hst.mo_ta)} />
      <a class="pp-btn" href="/nhan-hang">{hst.nut} <i>→</i></a>
    </div>
    <div class="pp-cards">
      {nhan.map((b) => (
        <a class="pp-card" href={`/nhan-hang/${b.ma}`}>
          <Anh src={b.anh_the_doc} alt={`Sản phẩm ${b.ten}`} sizes="(max-width:640px) 47vw, (max-width:1099px) 31vw, (max-width:1536px) 11vw, 166px" widths={[340, 700]} />
          <div class="pp-card__t"><div class="pp-card__n">{b.ten}</div><div class="pp-card__s" set:html={dong(b.cau_ngan)} /></div>
          <span class="pp-card__a">→</span>
        </a>
      ))}
    </div>
  </section>

  <BanLe nhan={tc.ban_le.nhan} tieuDe={tc.ban_le.tieu_de} />

  <DaiSoLieu />

  <section class="pp pp-ql">
    <div class="pp-ql__l">
      <div class="pp-eb">{qt.nhan}</div>
      <h2 class="pp-h" set:html={tieuDe(qt.tieu_de, 'i')} />
      <p class="pp-body" set:html={dong(khoiChung.quy_trinh.mo_ta)} />
      <div class="pp-mini">
        {qt.bieu_tuong_nho.map((m) => <div><Fragment set:html={bieuTuong(m.bieu_tuong)} /><span set:html={dong(m.chu)} /></div>)}
      </div>
      <a class="pp-btn" href="/chat-luong-tieu-chuan">{qt.nut} <i>→</i></a>
    </div>
    <div class="pp-qgrid">
      {khoiChung.quy_trinh.cac_khau.map((q) => (
        <div class="pp-qc rv">
          <Anh src={q.anh} alt={q.tieu_de} sizes="(max-width:640px) 92vw, (max-width:1099px) 46vw, (max-width:1536px) 16vw, 245px" widths={[490, 1100]} />
          <div class="pp-qc__b">
            <div class="pp-qc__t">{q.tieu_de}</div>
            <div class="pp-qc__d">{q.mo_ta}</div>
            <span class="pp-qc__a">→</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="stack g16">
        <div class="eb">{tt.nhan}</div>
        <h2 set:html={tieuDe(tt.tieu_de)} />
        <p class="lead" set:html={dong(tt.mo_ta)} />
      </div>
      <div class="nmg">
        {tt.anh.map((a) => (
          <figure class="nmc rv" style="margin:0">
            <Anh src={a.anh} alt={a.chu_thich} sizes="(max-width:560px) 92vw, (max-width:900px) 46vw, (max-width:1240px) 30vw, 368px" widths={[740, 1200]} />
            <figcaption>{a.chu_thich}</figcaption>
          </figure>
        ))}
      </div>
      {tt.video.length > 0 && (
        <div class="nmv">
          {tt.video.map((v) => (
            <figure class="rv"><div class="fr"><iframe src={`https://www.youtube-nocookie.com/embed/${v.ma_youtube}?rel=0&modestbranding=1&playsinline=1`} title={v.chu_thich} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><figcaption>{v.chu_thich}</figcaption></figure>
          ))}
        </div>
      )}
      {tt.ghi_chu && <p class="nm-note">{tt.ghi_chu}</p>}
    </div>
  </section>

  <section class="tran">
    <Anh src={sk.anh} alt="Tập thể cán bộ nhân viên Komlife trước nhà điều hành tại nhà máy Hưng Yên" sizes="100vw" widths={[960, 1920]} />
    <div class="tran__v"></div>
    <div class="tran__in"><div class="wrap"><div class="tran__t rv">
      <h2 set:html={tieuDe(sk.tieu_de)} />
      <p set:html={dong(sk.mo_ta)} />
    </div></div></div>
  </section>

  <section class="sec">
    <div class="wrap ngl">
      <div class="stack g16 ngl__l">
        <div class="eb">{nl.nhan}</div>
        <h2 set:html={tieuDe(nl.tieu_de)} />
        <p class="lead" set:html={dong(nl.mo_ta)} />
        {nl.anh && (
          <figure class="ngl__img rv" style="margin:0">
            <Anh src={nl.anh} alt={nl.chu_thich_anh || 'Komlife và đối tác nguyên liệu'} sizes="(max-width:940px) 92vw, (max-width:1240px) 40vw, 482px" widths={[500, 1000]} />
            {nl.chu_thich_anh && <figcaption>{nl.chu_thich_anh}</figcaption>}
          </figure>
        )}
      </div>
      <div class="ngl__r rv">
        {khoiChung.doi_tac_nguyen_lieu.map((n) => (
          <div class="ncc">
            <div class="ncc__n">{n.ten}</div>
            <div class="ncc__m"><span class="ncc__q">{n.quoc_gia}</span><span class="ncc__v">{n.nhom}</span></div>
            <p class="ncc__d">{n.mo_ta}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ChungNhan />

  <DauMoc nhan={dm.nhan} tieuDe={dm.tieu_de} anh={dm.anh} chuThich={dm.chu_thich_anh} />

  {ng.hien_thi && (
    <section class="sec sec--deep">
      <div class="wrap nguoi">
        <figure class="nguoi__img rv" style="margin:0">
          <Anh src={ng.anh} alt={`${ng.ten} — ${ng.chuc_vu}`} sizes="(max-width:820px) 92vw, (max-width:1240px) 27vw, 334px" widths={[360, 648]} />
        </figure>
        <div class="stack g16 rv">
          <div class="eb">{ng.nhan}</div>
          <p class="nguoi__q">{ng.trich_dan}</p>
          <div>
            <div class="nguoi__n">{ng.ten}</div>
            <div class="nguoi__r">{ng.chuc_vu}</div>
          </div>
        </div>
      </div>
    </section>
  )}

  {tin.length > 0 && (
    <section class="sec">
      <div class="wrap stack g40">
        <div class="stack g16" style="max-width:58ch">
          <div class="eb">{bt.nhan}</div>
          <h2 set:html={tieuDe(bt.tieu_de)} />
          <p class="lead" set:html={dong(bt.mo_ta)} />
        </div>
        <div class="cards cards--3 spot">
          {tin.map((t) => (
            <a class="tin rv" href={duongDanTin(t)}>
              <Anh src={t.data.anh_dai_dien} alt={chuTron(t.data.tieu_de)} sizes="(max-width:640px) 92vw, (max-width:1000px) 46vw, (max-width:1240px) 30vw, 367px" widths={[400, 800]} />
              <div class="tin__b"><div class="eb">{tenMuc[t.data.chuyen_muc]} · {ngayThang(t.data.ngay)}</div>
                <h3 style="font-size:1.1rem">{t.data.tieu_de}</h3><p class="card__b" style="font-size:.92rem">{t.data.tom_tat}</p></div>
            </a>
          ))}
        </div>
        <a class="btn btn--ghost" href="/tin-tuc" style="align-self:flex-start">Xem tất cả tin tức</a>
      </div>
    </section>
  )}

  <section class="sec">
    <div class="wrap stack g40">
      <div class="split npp">
        <div class="stack g16">
          <div class="eb">{npp.nhan}</div>
          <h2 set:html={tieuDe(npp.tieu_de)} />
          <p class="lead" set:html={dong(npp.mo_ta)} />
        </div>
        {npp.anh && (
          <figure class="npp__img rv" style="margin:0">
            <Anh src={npp.anh} alt={npp.chu_thich_anh || 'Hệ thống phân phối Komlife'} sizes="(max-width:940px) 92vw, (max-width:1240px) 52vw, 640px" widths={[740, 1400]} />
          </figure>
        )}
      </div>
      <div class="lo">
        {npp.cac_o.map((x) => (
          <div class="lo__i rv"><span class="lo__d"></span>
            <div><div class="lo__q">{x.tieu_de}</div><div class="lo__a">{x.mo_ta}</div></div></div>
        ))}
      </div>
    </div>
  </section>

  <DongHanh />
</Base>
