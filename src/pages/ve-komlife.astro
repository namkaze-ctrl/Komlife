---
// VỀ KOMLIFE — nội dung: src/content/trang/ve-komlife.json (+ các mốc ở Khối dùng chung)
import Base from '../layouts/Base.astro';
import DauTrangCon from '../components/DauTrangCon.astro';
import DaiSoLieu from '../components/DaiSoLieu.astro';
import DongHanh from '../components/DongHanh.astro';
import vk from '../content/trang/ve-komlife.json';
import { khoiChung } from '../lib/noi-dung';
import { tieuDe, dong } from '../lib/chu';
import { bieuTuong } from '../lib/bieu-tuong';
---
<Base tieuDe={vk.seo_tieu_de} moTa={vk.seo_mo_ta}>
  <DauTrangCon nhan={vk.dau_trang.nhan} tieuDe={vk.dau_trang.tieu_de} moTa={vk.dau_trang.mo_ta} />

  {/* HÀNH TRÌNH & TẦM NHÌN: các mốc cũ thu gọn thành đường "nền móng", điểm Hôm nay, rồi nổi bật Chặng tiếp theo */}
  <section class="sec ht">
    <div class="wrap stack g40">
      <div class="ht__dau">
        <div class="stack g16"><div class="eb">{vk.lich_su.nhan}</div><h2 set:html={tieuDe(vk.lich_su.tieu_de)} /></div>
        <p class="lead" set:html={dong(vk.lich_su.mo_ta)} />
      </div>
      <ol class="ht__duong rv">
        {khoiChung.dau_moc.map((m) => <li class="ht__moc"><span class="ht__y">{m.nam}</span><span class="ht__t">{m.tieu_de}</span></li>)}
        <li class="ht__moc ht__moc--nay"><span class="ht__y">{vk.lich_su.hom_nay.nam}</span><span class="ht__t"><b>{vk.lich_su.hom_nay.tieu_de}</b> · {vk.lich_su.hom_nay.mo_ta}</span></li>
      </ol>
      <div class="ht__tiep rv">
        <div class="ht__nhan">{vk.lich_su.nhan_tiep_theo} <i aria-hidden="true">→</i></div>
        <div class="ht__luoi">
          {vk.lich_su.huong_di.map((h) => (
            <div class="ht__the"><span class="ht__ic" set:html={bieuTuong(h.bieu_tuong)} /><h4>{h.ten}</h4><p>{h.mo_ta}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <DaiSoLieu />

  <section class="sec sec--panel">
    <div class="wrap cards cards--2">
      <div class="card"><div class="eb">Sứ mệnh</div><p class="lead" set:html={dong(vk.su_menh)} /></div>
      <div class="card"><div class="eb">Tầm nhìn</div><p class="lead" set:html={dong(vk.tam_nhin)} /></div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div class="stack g16"><div class="eb">{vk.gia_tri.nhan}</div><h2 set:html={tieuDe(vk.gia_tri.tieu_de)} /></div>
      <div class="rows">
        {vk.gia_tri.cac_gia_tri.map((g) => <div class="row rv"><div class="row__k">{g.ten}</div><div>{g.mo_ta}</div></div>)}
      </div>
    </div>
  </section>

  <DongHanh />
</Base>
