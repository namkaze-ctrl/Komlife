---
// Đầu trang nhãn kiểu mới (dùng khi nhãn đã có "Sản phẩm chi tiết"): màn đầu theo màu nhãn + dải ưu đãi đang chạy
// + lưới tất cả sản phẩm (bấm thẻ -> /nhan-hang/<nhãn>/<mã>). Phần còn lại của trang nhãn giữ nguyên màu Komlife.
import Anh from './Anh.astro';
import TheSanPham from './TheSanPham.astro';
import { dong, tieuDe } from '../lib/chu';
import { themUtm } from '../lib/landing';

interface Props { b: any; sanPham: any[]; tdDanhMuc: string; shopee: string; uuDai?: { href: string; ten: string } | null }
const { b, sanPham, tdDanhMuc, shopee, uuDai } = Astro.props;
const m = b.mau ?? {};
const bien = `--lp-chinh:${m.chinh || '#212b7e'};--lp-nhan:${m.nhan || '#3fc2cf'};--lp-nen:${m.nen || '#F1F2F9'};--lp-nut:${m.chinh || '#212b7e'};--lp-nut-re:${m.nhan || '#3fc2cf'}`;
// Chia nhóm danh mục theo ô "nhom" của sản phẩm (giữ thứ tự xuất hiện). Không sản phẩm nào có nhóm -> một lưới duy nhất.
const tenNhom: string[] = [...new Set(sanPham.map((p) => p.nhom).filter(Boolean))];
const nhom = tenNhom.length > 1 ? tenNhom.map((t) => ({ ten: t, ds: sanPham.filter((p) => p.nhom === t) })) : [];
// 3 thẻ ở màn đầu: có nhóm thì lấy sản phẩm đầu của mỗi nhóm cho đa dạng, không thì 3 sản phẩm đầu
const coAnh = sanPham.filter((p) => p.anh[0]);
const chai = (nhom.length >= 3 ? nhom.map((g) => g.ds.find((p) => p.anh[0])).filter(Boolean) : coAnh).slice(0, 3);
const linkMua = themUtm(shopee, `${b.ma}-trang-nhan`);
---
<div class="lp nhm" style={bien}>
  <section class={`ab-hero nhm-hero${b.anh_man_dau ? ' nhm-hero--anh' : ''}`}>
    {<svg class="ab-hero__blob" viewBox="0 0 600 600" aria-hidden="true"><path d="M421 63c77 41 141 118 146 203 6 85-47 177-121 239-74 61-169 92-252 63S42 448 25 361C8 274 49 176 118 109 187 42 344 22 421 63z"/></svg>}
    <div class="wrap ab-hero__in">
      <div class="stack g16 ab-hero__chu">
        <span class="lp-tag">{b.nganh}</span>
        <h1>{b.ten}</h1>
        {b.cau_dinh_vi && <p class="nhm-cau">{b.cau_dinh_vi}</p>}
        <p class="lead" set:html={dong(b.mo_ta)} />
        <div class="btnrow">
          <a class="lp-btn" href="#san-pham">Xem {sanPham.length} sản phẩm <i>↓</i></a>
          {linkMua && <a class="lp-btn lp-btn--phu" href={linkMua} target="_blank" rel="noopener" data-rasan="shopee" data-nhan={b.ma}>Mua trên Shopee <i>→</i></a>}
        </div>
        {(b.facebook || b.tiktok) && (
          <p class="nhm-mxh">
            <span>Theo dõi {b.ten}</span>
            {b.facebook && <a href={b.facebook} target="_blank" rel="noopener" data-rasan="facebook" data-nhan={b.ma}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.6-1.5h1.5V4.3c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8.2v3h2.5V21h2.8z"/></svg>Fanpage Facebook</a>}
            {b.tiktok && <a href={b.tiktok} target="_blank" rel="noopener" data-rasan="tiktok-kenh" data-nhan={b.ma}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3c.3 2.1 1.5 3.5 3.5 3.7v2.8c-1.3.1-2.5-.3-3.5-1v6.1c0 3.200-2.300 5.400-5.300 5.400-2.900 0-5.200-2.200-5.200-5 0-3.100 2.700-5.400 6-4.900v2.900c-1.5-.4-3 .5-3 2 0 1.2 1 2.1 2.2 2.1 1.4 0 2.3-.9 2.3-2.6V3h3z"/></svg>Video TikTok</a>}
          </p>
        )}
      </div>
      {/* Banner nằm ngay cạnh cột chữ, căn giữa cột phải (chỉ lấy phần có sản phẩm của ảnh) */}
      {b.anh_man_dau && <div class="nhm-hero__khung"><Anh src={b.anh_man_dau} alt={`${b.ten} — ${b.cau_dinh_vi || b.nganh}`} class="nhm-hero__anh" sizes="(max-width:700px) 100vw, 620px" widths={[800, 1200, 1920]} loading="eager" fetchpriority="high" /></div>}
      {!b.anh_man_dau && <div class="ab-hero__sp" aria-hidden="true">
        {chai.map((p, i) => <a href={`/nhan-hang/${p.nhan}/${p.ma}`} class={`ab-chai ab-chai--${i} ${p.anh_co_nen ? 'ab-chai--kin' : ''}`} style={`--sp-nhat:${p.mau_nhat}`} tabindex="-1"><Anh src={p.anh[0]} alt="" sizes="220px" loading="eager" /></a>)}
        {b.anh_linh_vat && <Anh src={b.anh_linh_vat} alt="" class="ab-tho" sizes="170px" loading="eager" />}
        {b.linh_vat_2 && <Anh src={b.linh_vat_2} alt="" class="ab-tho ab-tho--2" sizes="150px" loading="eager" />}
        {b.chu_man_dau && <Anh src={b.chu_man_dau} alt="" class="ab-chu-tt" sizes="300px" loading="eager" />}
      </div>}
    </div>
  </section>

  {uuDai && (
    <a class="nhm-uudai" href={uuDai.href}>
      <span class="nhm-uudai__nhan">Đang có ưu đãi</span>
      <span class="nhm-uudai__chu">{uuDai.ten}</span>
      <span class="nhm-uudai__xem">Xem ưu đãi →</span>
    </a>
  )}

  <section class="sec ab-sp" id="san-pham">
    <div class="wrap stack g28">
      <div class="stack g12 ab-sp__dau">
        <div class="eb">Sản phẩm</div>
        <h2 set:html={tdDanhMuc} />
        <p class="lead">Bấm vào từng sản phẩm để xem chi tiết, dung tích và nơi mua.</p>
      </div>
      {nhom.length > 0 ? (
        <>
          <nav class="nhm-nhomnav" aria-label="Nhóm sản phẩm">{nhom.map((g, i) => <a href={`#nhom-${i + 1}`}>{g.ten} <span>{g.ds.length}</span></a>)}</nav>
          {nhom.map((g, i) => (
            <div class="nhm-nhom" id={`nhom-${i + 1}`}>
              <h3 class="nhm-nhom__t">{g.ten}</h3>
              <div class="tsp-luoi">{g.ds.map((p) => <TheSanPham p={p} />)}</div>
            </div>
          ))}
        </>
      ) : <div class="tsp-luoi">{sanPham.map((p) => <TheSanPham p={p} />)}</div>}
      {b.diem_nhan.length > 0 && <ul class="ab-tin">{b.diem_nhan.map((x: string) => <li set:html={tieuDe(x).replace(/<span class="it">([^<]*)<\/span>/g, '<b>$1</b>')} />)}</ul>}
    </div>
  </section>
</div>
