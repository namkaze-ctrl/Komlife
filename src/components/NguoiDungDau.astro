---
// Khối "Người đứng đầu" (ảnh + câu trích). Trang chủ thêm dòng sứ mệnh + nút sang Về Komlife.
// Nội dung: Trang chủ → Người đứng đầu; sứ mệnh lấy từ trang Về Komlife.
import Anh from './Anh.astro';
import tc from '../content/trang/trang-chu.json';
import vk from '../content/trang/ve-komlife.json';
import { dong } from '../lib/chu';
interface Props { suMenh?: boolean }
const { suMenh = false } = Astro.props;
const ng = tc.nguoi_dung_dau;
---
{ng.hien_thi && (
  <section class={`sec sec--deep sec--nguoi${suMenh ? ' nguoi--tc' : ''}`}>
    <div class="wrap nguoi">
      <figure class="nguoi__img rv" style="margin:0">
        <Anh src={ng.anh} alt={`${ng.ten} — ${ng.chuc_vu}`} sizes="(max-width:820px) 92vw, (max-width:1240px) 27vw, 334px" widths={[360, 648, 800]} />
      </figure>
      <div class="stack g16 rv">
        <div class="eb">{ng.nhan}</div>
        <p class="nguoi__q">{ng.trich_dan}</p>
        <div class="nguoi__ky">
          <div class="nguoi__n">{ng.ten}</div>
          <div class="nguoi__r">{ng.chuc_vu}</div>
        </div>
        {suMenh && (
          <div class="nguoi__sm">
            <div class="nguoi__smk">Sứ mệnh</div>
            <p set:html={dong(vk.su_menh)} />
          </div>
        )}
        {suMenh && (
          <a class="nguoi__nut" href="/ve-komlife">Tìm hiểu về Komlife <i aria-hidden="true">→</i></a>
        )}
      </div>
    </div>
  </section>
)}
