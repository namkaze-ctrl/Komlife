---
// Dải logo các hệ thống bán lẻ đang bày hàng Komlife (chạy ngang). Nội dung: Khối dùng chung + Trang chủ.
import Anh from './Anh.astro';
import { khoiChung } from '../lib/noi-dung';
import { tieuDe } from '../lib/chu';
import tc from '../content/trang/trang-chu.json';
interface Props { nhan: string; tieuDe: string; phanPhoi?: boolean } // trang chủ: thêm 3 ô "Thông tin dành cho nhà phân phối"
const { nhan, tieuDe: td, phanPhoi = false } = Astro.props;
import { noiDung } from '../lib/ngon-ngu';
const { tc: tcN, ui, E } = noiDung(Astro.url);
const npp = tcN.nha_phan_phoi;
const ds = khoiChung.he_thong_ban_le;
---
<section class="sec sec--tight sec--panel sec--banle">
  <div class="wrap stack g28">
    <div class="stack g12" style="max-width:60ch">
      <div class="eb">{nhan}</div>
      <h2 style="font-size:clamp(1.6rem,2.6vw,2.2rem)" set:html={tieuDe(td)} />
    </div>
    <div class="dtrun rv"><div class="dtrun__t">
      {[0, 1].map((lan) => ds.map((d) => (
        <div class="dt" title={d.ten} aria-hidden={lan === 1 ? 'true' : undefined}>
          <Anh src={d.logo} alt={lan === 1 ? '' : d.ten} widths={[240]} sizes="120px" />
        </div>
      )))}
    </div></div>
    {phanPhoi && (
      <div class="ppo">
        {npp.cac_o.slice(0, 3).map((x) => (
          <div class="ppo__i rv"><div class="ppo__q">{x.tieu_de}</div><div class="ppo__a">{x.mo_ta}</div></div>
        ))}
        <a class="btn btn--ghost ppo__nut" href="/hop-tac-dai-ly">{E ? ui.npp_nut : 'Thông tin dành cho nhà phân phối'}</a>
      </div>
    )}
  </div>
</section>
