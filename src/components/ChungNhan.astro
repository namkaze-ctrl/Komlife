---
// Khối "Thông tin pháp lý": giấy chứng nhận, bấm vào phóng to. Nội dung: Khối dùng chung.
import { getImage } from 'astro:assets';
import Anh from './Anh.astro';
import { khoiChung } from '../lib/noi-dung';
import { timAnh } from '../lib/anh';
import { tieuDe, dong } from '../lib/chu';
interface Props { nguyenLieu?: boolean } // trang chủ: thêm dải 4 đối tác nguyên liệu dưới đoạn chữ
const { nguyenLieu = false } = Astro.props;
const p = khoiChung.phap_ly;
const giay = await Promise.all(p.giay.filter((g) => g.hien_thi !== false).map(async (g) => {
  const a = timAnh(g.anh);
  const lon = a ? (await getImage({ src: a, width: Math.min(a.width, 1800), format: 'jpg' })).src : g.anh;
  return { ...g, lon };
}));
---
{giay.length > 0 && (
<section class="sec">
  {/* Máy tính: chữ bên trái, hai giấy chứng nhận nằm gọn bên phải (trước đây mỗi giấy rộng nửa trang -> quá to) */}
  <div class="wrap pl">
    <div class="stack g16" style="max-width:58ch">
      <div class="eb">{p.nhan}</div>
      <h2 set:html={tieuDe(p.tieu_de)} />
      <p class="lead" set:html={dong(p.mo_ta)} />
      {nguyenLieu && (
        <div class="nlg">
          <div class="nlg__k">Đối tác nguyên liệu</div>
          <ul class="nlg__ds">
            {khoiChung.doi_tac_nguyen_lieu.map((n) => <li><b>{n.ten}</b><span>{n.quoc_gia} · {n.nhom}</span></li>)}
          </ul>
          <a class="nguoi__lnk nlg__lnk" href="/chat-luong-tieu-chuan">Quy trình và tiêu chuẩn chất lượng <i aria-hidden="true">→</i></a>
        </div>
      )}
    </div>
    <div class="giay">
      {giay.map((g) => (
        <div class="giay__i rv">
          <button type="button" data-lb={g.lon} aria-label={`Phóng to ${g.ten}`}>
            <Anh src={g.anh} alt={`Giấy chứng nhận ${g.ten} của Komlife`} sizes="(max-width:940px) 46vw, 300px" />
          </button>
          <div class="giay__c">
            <h3 style="font-size:1.06rem">{g.ten}</h3>
            <p class="card__b" style="font-size:.92rem">{g.pham_vi}</p>
            <div class="giay__m">
              {g.ma_so && <>Mã số <b>{g.ma_so}</b></>}
              {g.ngay_cap && <> · Cấp <b>{g.ngay_cap}</b></>}
              {g.noi_cap && <> · Nơi cấp {g.noi_cap}</>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
